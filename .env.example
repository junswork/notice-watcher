# .env 로 복사해서 채우세요. .env 는 절대 커밋하지 않습니다(.gitignore 처리됨).
# 깃허브 액션에서는 이 값들을 저장소 Settings > Secrets and variables > Actions
# 에 같은 이름으로 등록합니다.

# 알림을 받을 사람 (모든 봇 공통)
KAKAOWORK_USER_EMAIL=여기에_본인_카카오워크_이메일

# 게시판별 봇 앱키. 이름은 boards.json 의 "bot" 값과 같아야 한다.
KAKAOWORK_APP_KEY_NOTICE=
KAKAOWORK_APP_KEY_MATTERS=
KAKAOWORK_APP_KEY_HOUSING=
KAKAOWORK_APP_KEY_EPIC=

# 전용 봇이 아직 없는 게시판이 쓰는 공용 봇
KAKAOWORK_APP_KEY=

# 에픽폴리오 통합 계정 (로그인이 필요한 게시판)
EPIC_ID=
EPIC_PW=

# 게시판당 본문까지 확인할 게시물 수 (기본 25 = 1페이지 전체)
DETAIL_LIMIT=25
